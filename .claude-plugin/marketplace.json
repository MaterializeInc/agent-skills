{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "materialize",
  "description": "Claude Code plugins for developing with Materialize",
  "owner": {
    "name": "Materialize",
    "url": "https://materialize.com/"
  },
  "plugins": [
    {
      "name": "materialize",
      "source": "./",
      "strict": false,
      "description": "Materialize agent skills: docs, dbt, Terraform, mz-deploy, health checks, freshness debugging, and memory tuning",
      "category": "database",
      "tags": ["materialize", "sql", "streaming", "skills"],
      "license": "Apache-2.0",
      "repository": "https://github.com/MaterializeInc/agent-skills",
      "skills": [
        "./.agents/skills/materialize-docs",
        "./.agents/skills/mz-health-check",
        "./skills/mz-dbt",
        "./skills/mz-debug-freshness",
        "./skills/mz-deploy",
        "./skills/mz-ontology-design",
        "./skills/mz-optimize-memory",
        "./skills/mz-terraform-provider",
        "./skills/mz-terraform-self-managed"
      ]
    },
    {
      "name": "mz-sql-lsp",
      "source": "./plugins/mz-sql-lsp",
      "description": "Materialize SQL language server (mz-deploy lsp) for go-to-definition, hover, and symbols in .sql files",
      "category": "language-support",
      "tags": ["materialize", "sql", "lsp", "mz-deploy"],
      "license": "Apache-2.0",
      "repository": "https://github.com/MaterializeInc/agent-skills"
    }
  ]
}
